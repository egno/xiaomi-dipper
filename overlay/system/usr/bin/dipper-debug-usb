#!/bin/sh
# Debug-only: bring up an ADB gadget early and unconditionally so logs can be
# captured even when the graphical boot hangs. Bypasses usb-moded.
exec >/dev/kmsg 2>&1
echo "dipper-debug-usb: start"

CONFIGFS=/sys/kernel/config
GADGET=$CONFIGFS/usb_gadget/g1
UDC_NAME=a600000.dwc3

modprobe libcomposite 2>/dev/null || true
mountpoint -q "$CONFIGFS" || mount -t configfs none "$CONFIGFS" 2>/dev/null || true

mkdir -p "$GADGET" 2>/dev/null || true
cd "$GADGET" 2>/dev/null || { echo "dipper-debug-usb: no gadget dir"; exit 0; }

echo 0x18d1 > idVendor 2>/dev/null || true
echo 0xd001 > idProduct 2>/dev/null || true
echo 0x0100 > bcdDevice 2>/dev/null || true
echo 0x0200 > bcdUSB 2>/dev/null || true
mkdir -p strings/0x409 2>/dev/null || true
echo dipper > strings/0x409/serialnumber 2>/dev/null || true
echo UBports > strings/0x409/manufacturer 2>/dev/null || true
echo "Xiaomi Mi 8" > strings/0x409/product 2>/dev/null || true

mkdir -p functions/ffs.adb 2>/dev/null || true
mkdir -p configs/c.1/strings/0x409 2>/dev/null || true
echo adb > configs/c.1/strings/0x409/configuration 2>/dev/null || true
[ -e configs/c.1/ffs.adb ] || ln -s functions/ffs.adb configs/c.1/ 2>/dev/null || true

mkdir -p /dev/usb-ffs/adb 2>/dev/null || true
mountpoint -q /dev/usb-ffs/adb || mount -t functionfs adb /dev/usb-ffs/adb 2>/dev/null || true

# adbd opens ep0 and writes descriptors into functionfs; start it before binding UDC.
systemctl start android-tools-adbd.service 2>/dev/null &
ADBD="$(command -v adbd 2>/dev/null || true)"
[ -n "$ADBD" ] && ( "$ADBD" & ) 2>/dev/null

# Wait for functionfs endpoints to appear (adbd ready), then bind the UDC.
i=0
while [ "$i" -lt 30 ]; do
    [ -e /dev/usb-ffs/adb/ep1 ] && break
    i=$((i + 1))
    sleep 1
done

if [ -d "/sys/class/udc/$UDC_NAME" ]; then
    echo "$UDC_NAME" > UDC 2>/dev/null || true
else
    ls /sys/class/udc 2>/dev/null | head -n1 > UDC 2>/dev/null || true
fi

echo "dipper-debug-usb: done UDC=$(cat UDC 2>/dev/null)"
exit 0
