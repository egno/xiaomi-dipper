#!/bin/sh
# Dipper-specific setup after the Android container is running.

set -e

mkdir -p /dev/cpuset
mount none /dev/cpuset -t cpuset -o nodev,noexec,nosuid 2>/dev/null || true

umount /android/cache 2>/dev/null || true
mkdir -p /userdata/cache /android/cache/recovery
mount -o bind /userdata/cache /android/cache

if [ -d /android/metadata ]; then
    mount -o bind /android/metadata /var/lib/lxc/android/rootfs/metadata
fi
